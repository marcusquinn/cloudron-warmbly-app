# Warmbly settings for this Cloudron app. Edit with the File Manager or the
# web terminal, then restart the app. One KEY=value per line; values are
# literal (never evaluated); surrounding quotes are optional.
#
# Addon wiring, URLs, listeners, providers and secrets are managed by the
# package and ignored here (start.sh logs each ignored key). Reference:
# https://github.com/warmbly/warmbly/blob/main/deploy/config/env.example

# ── Who gets in ─────────────────────────────────────────────────────────────
# true | false | invite_only (default). The very first sign-up is always
# allowed, so the claim link works on a fresh instance.
# DISABLE_REGISTRATION=invite_only
# always | new_device | off (default)
# AUTH_LOGIN_CODE=off
# REQUIRE_EMAIL_VERIFICATION=false
# DISABLE_PASSWORD_LOGIN=false
#
# Cloudron single sign-on (when enabled at install):
# OIDC_PROVIDER_NAME=Cloudron
# A Cloudron user's first sign-in creates their account (default true);
# false requires an invitation, as for password sign-up.
# SSO_AUTO_PROVISION=true
# The first Cloudron sign-in on an empty instance becomes its owner and
# platform admin (default true); false uses `warmblyctl setup-link` instead.
# WARMBLY_OIDC_FIRST_USER_OWNER=true
# OIDC_ALLOWED_DOMAINS=example.com
# OIDC_DEFAULT_ORG=          # organization id every SSO user joins

# ── Platform email ──────────────────────────────────────────────────────────
# Sent through the Cloudron mail relay by default. To use another relay:
# MAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SECURITY=starttls
# EMAIL_ADDRESS=noreply@example.com
# EMAIL_NAME=Warmbly

# ── Mailbox connections (OAuth) ─────────────────────────────────────────────
# Gmail: a Google Cloud "Web application" OAuth client with redirect URI
#   https://<API domain>/addresses/google/callback
# and the consent-screen scopes https://mail.google.com/ and
#   https://www.googleapis.com/auth/gmail.settings.basic (see the README).
# BOX_GOOGLE_CLIENT_ID=
# BOX_GOOGLE_CLIENT_SECRET=
# BOX_GOOGLE_OAUTH_CONNECT=true
# Microsoft 365 / Outlook, redirect URI https://<API domain>/addresses/outlook/callback
# BOX_OUTLOOK_CLIENT_ID=
# BOX_OUTLOOK_CLIENT_SECRET=

# ── Whose instance this is (transactional email and public pages) ───────────
# EMAIL_BRAND_NAME=Acme
# EMAIL_BRAND_WEBSITE_URL=https://acme.example
# EMAIL_BRAND_TERMS_URL=
# EMAIL_BRAND_PRIVACY_URL=
# EMAIL_BRAND_SUPPORT_EMAIL=
# EMAIL_BRAND_LEGAL_ENTITY=
# EMAIL_BRAND_ADDRESS=

# ── AI provider (optional; AI features are off without one) ─────────────────
# AI_PROVIDER=               # openai | openrouter | groq | ollama | anthropic | custom
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=

# ── Data control, seeded on first boot then edited in the admin panel ───────
# WARMBLY_SETTINGS_BOOTSTRAP={"sync":{"backfill_days":30},"retention":{"engagement_event_days":30,"form_event_days":30,"audit_log_days":30}}

# ── Location labels (optional) ──────────────────────────────────────────────
# Put a GeoLite2-City.mmdb in /app/data/geo/ or point GEODB_PATH at one.
# GEODB_PATH=/app/data/geo/GeoLite2-City.mmdb
