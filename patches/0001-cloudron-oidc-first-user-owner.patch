diff --git a/internal/app/auth/cloudron_first_owner.go b/internal/app/auth/cloudron_first_owner.go
new file mode 100644
--- /dev/null
+++ b/internal/app/auth/cloudron_first_owner.go
@@ -0,0 +1,79 @@
+// Cloudron package patch: the first person to sign in through the OIDC
+// provider on an empty instance becomes its owner and platform admin, the
+// same grant the `warmblyctl setup-link` claim makes. Opt-in with
+// WARMBLY_OIDC_FIRST_USER_OWNER=true; Apple, Google and password signups never
+// take this path.
+package auth
+
+import (
+	"context"
+	"log"
+	"os"
+	"slices"
+	"strings"
+
+	"github.com/google/uuid"
+	"github.com/warmbly/warmbly/internal/models"
+	"github.com/warmbly/warmbly/internal/observability/errs"
+)
+
+// firstOwnerClaimer is satisfied by the Postgres user repository.
+type firstOwnerClaimer interface {
+	ClaimFirstOwner(ctx context.Context, userID uuid.UUID, permissions uint32) (bool, error)
+}
+
+// OIDCFirstUserOwner reports whether the first OIDC sign-in claims the instance.
+func OIDCFirstUserOwner() bool {
+	switch strings.ToLower(strings.TrimSpace(os.Getenv("WARMBLY_OIDC_FIRST_USER_OWNER"))) {
+	case "1", "true", "yes", "on":
+		return true
+	}
+	return false
+}
+
+// OIDCFirstOwnerAvailable reports whether an empty instance is claimed by
+// signing in with OIDC, so the login screen offers that instead of /setup.
+func OIDCFirstOwnerAvailable(providers []string) bool {
+	return OIDCFirstUserOwner() && slices.Contains(providers, models.IdentityProviderOIDC)
+}
+
+// firstOwnerCandidate is true for an OIDC signup on an instance with no users yet.
+func (s *authService) firstOwnerCandidate(ctx context.Context, provider string) bool {
+	if provider != models.IdentityProviderOIDC || !OIDCFirstUserOwner() {
+		return false
+	}
+	empty, err := s.userRepository.IsEmpty(ctx)
+	return err == nil && empty
+}
+
+// firstOwnerReserved is true while the empty instance is held for its first
+// OIDC sign-in. Password, Apple and Google signups are refused until then, so
+// a stranger cannot create the first account and take the owner slot. The
+// setup link and warmblyctl do not pass through these gates and still work.
+func (s *authService) firstOwnerReserved(ctx context.Context) bool {
+	if !OIDCFirstUserOwner() {
+		return false
+	}
+	empty, err := s.userRepository.IsEmpty(ctx)
+	return err == nil && empty
+}
+
+// claimFirstOwner grants full admin unless another account already holds
+// admin. It never fails the sign-in: the account exists either way, and
+// `warmblyctl user grant-admin` can still promote it by hand.
+func (s *authService) claimFirstOwner(ctx context.Context, userID uuid.UUID, address string) {
+	c, ok := s.userRepository.(firstOwnerClaimer)
+	if !ok {
+		log.Printf("Warning: first OIDC owner: the user repository cannot grant admin; %s stays an ordinary user.", address)
+		return
+	}
+	granted, err := c.ClaimFirstOwner(ctx, userID, uint32(models.AllAdminPermissions))
+	if err != nil {
+		errs.CaptureException(err)
+		log.Printf("Warning: first OIDC owner: granting admin to %s failed: %v", address, err)
+		return
+	}
+	if granted {
+		log.Printf("Setup: %s signed in first through OIDC and is now this instance's owner and platform admin.", address)
+	}
+}
