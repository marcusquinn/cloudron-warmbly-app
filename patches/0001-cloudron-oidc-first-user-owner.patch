+// ClaimFirstOwner grants full platform admin to userID only while no account
+// holds any admin permission. Cloudron package patch: the first OIDC sign-in
+// on an empty instance becomes its owner. A transaction-scoped advisory lock
+// serialises concurrent claims, so two simultaneous first sign-ins can never
+// both be granted; the loser stays an ordinary user.
+func (r *userRepository) ClaimFirstOwner(ctx context.Context, userID uuid.UUID, permissions uint32) (bool, error) {
+	tx, err := r.DB.Begin(ctx)
+	if err != nil {
+		return false, err
+	}
+	defer func() { _ = tx.Rollback(ctx) }()
+
+	if _, err := tx.Exec(ctx, `SELECT pg_advisory_xact_lock(hashtext('cloudron:first-oidc-owner'))`); err != nil {
+		return false, err
+	}
+	tag, err := tx.Exec(ctx, `
+		UPDATE users SET
+			admin_permissions = $2,
+			admin_granted_at = NOW(),
+			admin_granted_by = NULL,
+			updated_at = NOW()
+		WHERE id = $1
+		  AND NOT EXISTS (SELECT 1 FROM users WHERE admin_permissions <> 0)
+	`, userID, permissions)
+	if err != nil {
+		return false, err
+	}
+	if err := tx.Commit(ctx); err != nil {
+		return false, err
+	}
+	return tag.RowsAffected() == 1, nil
+}
